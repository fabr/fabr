plugin @fabr/js;

catalog @pkg {
  deps = @npm:typescript:5.4.5 @npm:@types/node:20.12.7
         @npm:chai:4.3.6 @npm:@types/chai:4.3.1
         @npm:chai-as-promised:7.1.1 @npm:@types/chai-as-promised:7.1.8
         @npm:@parcel/watcher:2.4.1
         @npm:picomatch:2.3.1
         @npm:unicode-properties:1.3.1 @npm:@types/unicode-properties:1.3.0
         @npm:tar-stream:3.1.7 @npm:@types/tar-stream:3.1.3;
}

TSC = @pkg:typescript:tsc;
JS_TARGET = es2018-commonjs;

chai = @pkg:chai @pkg:@types/chai @pkg:chai-as-promised @pkg:@types/chai-as-promised;
unicode_properties = @pkg:unicode-properties @pkg:@types/unicode-properties;
tar_stream = @pkg:tar-stream @pkg:@types/tar-stream;

js_package @fabr/core {
  srcs = packages/core/src:**/*.ts packages/core:lib/**;
  tests = packages/core/src:**/*.test.ts;
  deps = es2021 @pkg:@types/node @pkg:@parcel/watcher @pkg:picomatch unicode_properties tar_stream;
  test_deps = chai;
}

js_package @fabr/js {
  srcs = packages/js/src:**/*.ts packages/js:lib/**;
  tests = packages/js/src:**/*.test.ts;
  deps = es2021 @pkg:@types/node @fabr/core;
  test_deps = chai;
}

js_package @fabr/fabr {
  srcs = packages/fabr/src:**/*.ts;
  tests = packages/fabr/src:**/*.test.ts;
  deps = es2021 @pkg:@types/node @fabr/core @fabr/js;
  test_deps = chai;
}

# End-to-end tests: drive the built fabr CLI directly.
js_test e2e_tests {
  srcs = packages/fabr/test:**/*.ts;
  deps = es2021 @pkg:@types/node chai @fabr/fabr;
}
