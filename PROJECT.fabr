plugin @fabr-build/js;

include docs/BUILD.fabr;

FABR_VERSION=0.3.1;
FABR_METADATA = {
  keywords = build-tool build-system monorepo;
  license = GPL-3.0-or-later;
  homepage = https://fabr.build/;
  engines = {
    node = ">=22.19.0";
  }
  author = {
    name = Nathan Keynes;
    email = nkeynes@deadcoderemoval.net;
  }
  repository = {
    type = git;
    url = https://github.com/fabr/fabr;
  }
  bugs = {
    url = https://github.com/fabr/fabr/issues;
  }
};

catalog @pkg {
  deps = @npm:typescript:5.4.5 @npm:@types/node:22.15.3
         @npm:chai:4.3.6 @npm:@types/chai:4.3.1
         @npm:@types/jest:30.0.0
         @npm:chai-as-promised:7.1.1 @npm:@types/chai-as-promised:7.1.8
         @npm:@parcel/watcher:2.6.0
         @npm:picomatch:4.0.5
         @npm:undici:8.9.0
         @npm:unicode-properties:1.3.1 @npm:@types/unicode-properties:1.3.0
         @npm:tar-stream:3.1.7 @npm:@types/tar-stream:3.1.3
         @npm:@napi-rs/lzma:1.5.1
         @npm:diff:9.0.0

         # The bundle driver's tests drive the real bundler; pinned to the same
         # version ESBUILD names, since what they check is what THAT esbuild
         # does with a package's export conditions.
         @npm:esbuild:0.28.1
         # The postcss driver's tests drive the real scoper, pinned to the same
         # versions POSTCSS/POSTCSS_MODULES name: the css-modules dialect is
         # the plugin set's, so the one the tests pin must be the one fabr runs.
         @npm:postcss:8.5.28 @npm:postcss-modules:9.0.1
         # The coverage driver's libraries. ast-v8-to-istanbul's js-tokens sits
         # beside the one @types/jest's closure needs ('?' sanctions the
         # coexistence).
         @npm:ast-v8-to-istanbul:1.0.7 @npm:acorn:8.19.0 @npm:@bcoe/v8-coverage:1.0.2
         @npm:js-tokens:10.0.0? @npm:js-tokens:4.0.0?
         # The PnP resolver's conformance suite runs Yarn's own runtime as its
         # oracle. The js and Sass-importer tests use it beside our own
         # @types/node, and it requires 18 (with its undici-types) — '?'
         # sanctions the coexistence (our 22.15.3 is pinned above).
         @npm:@yarnpkg/pnp:4.1.7 @npm:@yarnpkg/fslib:3.1.5
         @npm:@types/node:18.19.124?
         @npm:undici-types:6.21.0? @npm:undici-types:5.26.4?
         # The Sass importer's tests drive the real compiler, pinned to the
         # version SASS names. Those tests use it beside @types/jest and fslib,
         # whose closures need other supports-color and tslib versions ('?'
         # sanctions the coexistence).
         @npm:sass-embedded:1.100.0
         @npm:supports-color:8.1.1? @npm:supports-color:7.1.0?
         @npm:tslib:2.4.0? @npm:tslib:2.1.0?
         # Pulled in transitively by @types/jest, and required only without a
         # lower bound ('*', the DefinitelyTyped house style), so nothing picks
         # a version for them; and two packages @types/jest's closure needs at a
         # version other than ours ('?' sanctions the coexistence).
         @npm:@types/istanbul-lib-report:3.0.3? @npm:@types/yargs-parser:21.0.3?
         @npm:ansi-styles:4.1.0? @npm:ansi-styles:5.2.0?
         @npm:picomatch:2.3.1? @npm:picomatch:4.0.5?;
}

TYPESCRIPT = @pkg:typescript;
# The bundler, pinned from the same catalog for the same reason: the bundle
# driver's tests assert what THIS esbuild does with a package's conditions, so
# the one they run must be the one fabr runs.
ESBUILD = @pkg:esbuild;
JS_TARGET = es2021-commonjs;

# Run fabr's own tests through the jest-compatibility runner. They use none of
# jest's API — plain describe/it plus chai assertions — which is exactly why
# they are worth running under it: the layer has to carry an ordinary suite
# unchanged before it can claim to carry a jest one. (`yarn test` runs the same
# files under real jest, so the two agree by construction.)
JS_TEST_FRAMEWORK = jest;

# The describe/it/expect globals' types. The jest runner ships no ambient
# globals of its own — these would collide with them — so a target using it
# declares them like any other test dependency.
jest_types = @pkg:@types/jest;

chai = @pkg:chai @pkg:@types/chai @pkg:chai-as-promised @pkg:@types/chai-as-promised;
unicode_properties = @pkg:unicode-properties @pkg:@types/unicode-properties;
tar_stream = @pkg:tar-stream @pkg:@types/tar-stream;

js_package @fabr-build/core {
  srcs = packages/core/src:**/*.ts packages/core:lib/** README.md COPYING -> LICENSE;
  tests = packages/core/src:**/*.test.ts;
  deps = @pkg:@types/node @pkg:@parcel/watcher @pkg:picomatch @pkg:undici @pkg:@napi-rs/lzma @pkg:diff
         unicode_properties tar_stream;
  test_deps = chai jest_types;
  metadata = { FABR_METADATA; description = Fabr core }
}

# The curated npm package-extension list (Yarn's, which pnpm also applies) as
# the JSON @fabr-build/js ships in lib/. The list's module loads nothing else,
# so the script takes that one file rather than the package.
js_script package_extensions_json {
  entry = scripts:package-extensions-json.js;
  deps = @npm:@yarnpkg/extensions:2.0.7:lib/index.js -> yarnpkg-extensions.js;
}

generate package_extensions {
  run = package_extensions_json > package-extensions.json;
}

# The runtime half of the plugin: the drivers and test runners fabr launches,
# and the documents they read. The plugin's own tests check the two halves agree.
js_package @fabr-build/js-tools {
  srcs = packages/js-tools/src:**/*.ts README.md COPYING -> LICENSE;
  exports = packages/js-tools/src:index.ts;
  tests = packages/js-tools/src:**/*.test.ts;
  # The coverage driver's libraries.
  deps = @pkg:@types/node @pkg:ast-v8-to-istanbul @pkg:acorn @pkg:@bcoe/v8-coverage;
  # The test runners write core's CTRF report, whose types they compile against;
  # nothing loads core at run time.
  optional_provided_deps = @fabr-build/core;
  # postcss / postcss-modules: the PostCSS driver's tests scope real stylesheets.
  # typescript: the coverage driver's tests compile a fixture to measure.
  test_deps = chai jest_types @pkg:postcss @pkg:postcss-modules @pkg:typescript;
  metadata = { FABR_METADATA; description = Fabr JS support plugin tools }
}

# Stage 0: compiling @fabr-build/js-tools needs a tsc driver, so this build takes
# the one installed with the fabr running it rather than the one it builds.
@fabr-boot = @fabr-home:@fabr-build;
js_script TSC_DRIVER {
  entry = @fabr-boot/js-tools:fabr-tsc;
  deps = ${TYPESCRIPT};
}

js_package @fabr-build/js {
  srcs = packages/js/src:**/*.ts packages/js:lib/** package_extensions:** -> lib/** README.md COPYING -> LICENSE;
  exports = packages/js/src:index.ts;
  tests = packages/js/src:**/*.test.ts;
  # The Sass importer is no import of the plugin's: it rides along so installing
  # fabr installs it, for the Sass driver (SASS_PNP_IMPORTER).
  deps = @pkg:@types/node @fabr-build/js-tools @fabr-build/sass-pnp-importer;
  provided_deps = @fabr-build/core;
  # typescript / esbuild: the tsc and bundle drivers' tests drive the real tools
  # (each driver itself requires its own from the tool install fabr stages,
  # never from here). The bundler's single-variant rule is a claim about what
  # esbuild does with a package's conditions, so only the real one can hold it.
  # @yarnpkg/pnp: the PnP resolver is checked against Yarn's own runtime.
  # sass-embedded + the importer: the Sass driver's tests lower real stylesheets.
  test_deps = chai jest_types tar_stream @pkg:typescript @pkg:esbuild @pkg:postcss @pkg:postcss-modules
              @pkg:@yarnpkg/pnp @pkg:@yarnpkg/fslib @pkg:sass-embedded @fabr-build/sass-pnp-importer;
  metadata = { FABR_METADATA; description = Fabr JS support plugin }
}

js_package @fabr-build/sass-pnp-importer {
  srcs = packages/sass-pnp-importer/src:**/*.ts packages/sass-pnp-importer:README.md COPYING -> LICENSE;
  exports = packages/sass-pnp-importer/src:index.ts;
  tests = packages/sass-pnp-importer/src:**/*.test.ts;
  deps = @pkg:@types/node;
  test_deps = chai jest_types @pkg:sass-embedded @pkg:@yarnpkg/pnp @pkg:@yarnpkg/fslib;
  metadata = {
    FABR_METADATA;
    keywords = sass sass-importer pnp plug-n-play yarn;
    description = "A Sass importer resolving package stylesheets through a Plug'n'Play dependency table";
  }
}

js_package @fabr-build/cli {
  srcs = packages/cli/src:**/*.ts README.md COPYING -> LICENSE;
  tests = packages/cli/src:**/*.test.ts;
  deps = @pkg:@types/node @fabr-build/core @fabr-build/js;
  test_deps = chai jest_types;
  metadata = { FABR_METADATA; description = Fabr CLI }
}

# End-to-end tests: drive the built fabr CLI directly. The harness is a plain
# source dep — compiled as a sibling (so `./harness` resolves) but never run.
js_test e2e_tests {
  tests = test:**/*.test.ts;
  deps = test:**/*.ts @pkg:@types/node chai jest_types @fabr-build/cli;
}

sync release {
  @npm:@fabr-build/cli:${FABR_VERSION} = @fabr-build/cli;
  @npm:@fabr-build/core:${FABR_VERSION} = @fabr-build/core;
  @npm:@fabr-build/js:${FABR_VERSION} = @fabr-build/js;
  @npm:@fabr-build/js-tools:${FABR_VERSION} = @fabr-build/js-tools;
  @npm:@fabr-build/sass-pnp-importer:${FABR_VERSION} = @fabr-build/sass-pnp-importer;
}

all = @fabr-build/core @fabr-build/js @fabr-build/js-tools @fabr-build/cli @fabr-build/sass-pnp-importer;