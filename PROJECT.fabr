plugin @fabr/js;

TSC = @npm:typescript:5.4.5:tsc;
JS_TARGET = es2018-commonjs;

chai = @npm:chai:4.3.6 @npm:@types/chai:4.3.1
       @npm:chai-as-promised:7.1.1 @npm:@types/chai-as-promised:7.1.8;

parcel_watcher = @npm:@parcel/watcher:2.4.1;
picomatch = @npm:picomatch:2.3.1;
unicode_properties = @npm:unicode-properties:1.3.1 @npm:@types/unicode-properties:1.3.0;
tar_stream = @npm:tar-stream:3.1.7 @npm:@types/tar-stream:3.1.3;

js_package @fabr/core {
  srcs = packages/core/src:**/*.ts packages/core:lib/**;
  tests = packages/core/src:**/*.test.ts;
  deps = es2021 nodejs parcel_watcher picomatch unicode_properties tar_stream;
  test_deps = chai;
}

js_package @fabr/js {
  srcs = packages/js/src:**/*.ts packages/js:lib/**;
  tests = packages/js/src:**/*.test.ts;
  deps = es2021 nodejs @fabr/core;
  test_deps = chai;
}

js_package @fabr/fabr {
  srcs = packages/fabr/src:**/*.ts;
  tests = packages/fabr/src:**/*.test.ts;
  deps = es2021 nodejs @fabr/core @fabr/js;
  test_deps = chai;
}

# End-to-end tests: drive the built fabr CLI directly.
js_test e2e_tests {
  srcs = packages/fabr/test:**/*.ts;
  deps = es2021 nodejs chai @fabr/fabr;
}
