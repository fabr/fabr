{
  "name": "fabr-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/fabr/fabrjs",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copylibs.js",
    "test": "jest",
    "lint": "eslint packages test",
    "fabr": "node packages/cli/build/index.js",
    "bootstrap": "yarn build && yarn fabr @fabr-build/core @fabr-build/js @fabr-build/cli && yarn fabr test @fabr-build/core @fabr-build/js @fabr-build/cli e2e_tests",
    "dist": "yarn build && yarn test && yarn lint"
  },
  "devDependencies": {
    "@types/chai": "^4.3.1",
    "@types/chai-as-promised": "^7.1.8",
    "@types/chai-subset": "^1.3.3",
    "@types/jest": "^27.4.0",
    "@types/node": "^20.12.7",
    "@types/tar-stream": "^3.1.3",
    "@types/unicode-properties": "^1.3.0",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "chai-subset": "^1.6.0",
    "eslint": "^9.1.1",
    "eslint-config-prettier": "^8.5.0",
    "jest": "^27.4.7",
    "prettier": "^2.5.1",
    "ts-jest": "^27.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0"
  }
}
