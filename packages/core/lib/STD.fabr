#
# How far a build is optimised and how much debugging information it keeps:
# `debug` (not optimised, full debugging information), `relwithdebinfo`
# (optimised, debugging information kept) or `release` (optimised, debugging
# information removed).
default BUILD_TYPE = debug;

# What is being done with a target: `build` (produce its output), `test` (run
# its tests), `run` (produce it as a program that can be launched) or `files`
# (its built output as plain files). The `build`, `test` and `run` commands set
# it; a build script can require it of a dependency (`tool<BUILD_OPERATION=run>`).
default BUILD_OPERATION = build;

# What a test run does when a result differs from the expectation recorded for
# it, such as a snapshot: `check` fails the test and reports the difference;
# `update` records the new result and, after a passing run, writes the changed
# records back into the source tree. `fabr test -u` sets `update` for one run.
default TEST_EXPECTATIONS = check;

# The platform being built for, as a clang/LLVM target triple such as
# `arm64-apple-macosx15.0` or `x86_64-linux-gnu`. Defaults to `HOST`, the
# machine fabr is running on. Set it to cross-compile: for a whole run with
# `-DTARGET=…`, or for one dependency with `mylib<TARGET=…>`. Platform-specific
# packages are selected by it.
default TARGET = ${HOST};


#
# A named set of dependencies whose versions are chosen once, together. Refer to
# a member wherever a dependency is wanted as `<catalog>:<package>`, with no
# version:
#
#     catalog @pkg { deps = @npm:react:^19.1.0 @npm:react-dom:^19.1.0; }
#
#     js_package ui { srcs = src:**/*.tsx; deps = @pkg:react @pkg:react-dom; }
#
# Every target that uses the catalog gets the same version of each member, and
# of everything the members depend on. A member is downloaded only when a target
# uses it.
#
targetdef catalog {
    # The members: packages from a registry, each with its version, or package
    # targets of this project.
    deps = FILES;
}

#
# Run a command and keep its output as the target's files, for code generation
# or any step that no other target type covers:
#
#     generate api_docs {
#         srcs = ./templates/**;
#         run = list_api --json | render_docs > reference.md;
#     }
#
# Each command in `run` is a runnable target or package, never a program found
# on the host. The commands run in a directory holding `srcs`.
#
# The result is the files the redirections capture (`> name`). When `output` is
# set, the result is instead the files it selects, from the captured files and
# from anything the commands wrote.
#
targetdef generate {
    # Input files, placed in the directory the commands run in.
    srcs = FILES;
    # The command to run: a pipeline of runnables with their arguments, with
    # `|`, `<`, `>`, `2>` and `&>` as in a shell.
    run = REQUIRED COMMAND;
    # Which files to keep, as a pattern with an optional rename: `dist:**`,
    # `*.out -> *.txt`.
    output = STRING;
    # Environment variables for the commands, which run with no others.
    env = MAP;
}

#
# Apply patches to a package, or to plain files:
#
#     patched glob-promise { srcs = @npm:glob-promise:1.33.0; patches = patches/glob.patch; }
#
# When `srcs` is one package, the result is a package with this target's name
# and the original's version and dependencies. Naming the target after the
# package therefore replaces that package wherever it is used. For anything
# else, the result is the patched files.
#
targetdef patched {
    # What to patch.
    srcs = REQUIRED FILES;
    # Unified diffs, applied in the order written, with paths as git writes
    # them (`a/lib/x.js`).
    patches = REQUIRED FILES;
}

#
# A shell script that can be run: with `fabr run`, as a command in a `generate`
# target, or as the `tool` of a `serve` target.
#
targetdef script {
    # Other files the script needs, placed alongside it under their own names.
    deps = FILES;
    # The script file, which is run with `sh`.
    entry = REQUIRED FILES;
    # Arguments passed to the script ahead of any given when it is run.
    args = STRING;
}

#
# A long-running program together with the files it serves, such as a
# development server:
#
#     serve site { tool = @npm:http-server:14.1.1; files = site_build; args = -c-1 .; }
#
# `fabr run site` starts the program in a directory containing `files`, so a
# static file server needs no path argument. Under `fabr run -w`, a change to
# `files` is copied into that directory while the program keeps running; a
# change to `tool`, `deps`, `args` or `env` restarts it.
#
targetdef serve {
    # The program to run: a `script` or `js_script` target, or a package that
    # has a command-line program.
    tool = REQUIRED FILES;
    # Other files the program needs, placed in the directory it runs in.
    deps = FILES;
    # Arguments passed to the program ahead of any given to `fabr run`.
    args = STRING;
    # The content to serve.
    files = FILES;
    # Environment variables added to those `fabr run` was started with.
    env = MAP;
}

#
# Publish built packages to a registry. Each entry names where a package goes
# and which target supplies it; for an npm registry that is
# `<registry>:<name>:<version> = <target>;`:
#
#     sync release {
#         @npm:@acme/core:1.2.0 = @acme/core<BUILD_TYPE=release>;
#         @npm:@acme/cli:1.2.0  = @acme/cli<BUILD_TYPE=release>;
#     }
#
# An entry publishes the build type it is given, so `<BUILD_TYPE=release>` on
# the target is what makes the published package a release build.
#
# `fabr build release` produces the packages as they would be published, without
# uploading anything. `fabr sync release` uploads them, each after the packages
# it depends on. Where one entry depends on another, the published package
# requires the version assigned to it here.
#
targetdef sync {
    * = FILES;
}

#
# A set of files to download, each with the integrity hash its contents must
# match:
#
#     fetch @dl { node.tar.gz = "https://nodejs.org/dist/v22.15.0/node-v22.15.0.tar.gz" "sha256-…"; }
#
# `@dl:node.tar.gz` is then the downloaded file, and `@dl:node.tar.gz:*:bin/node`
# a file inside the archive. The hash is required, is written
# `<algorithm>-<base64>`, and is checked on every download. A file is downloaded
# only when something refers to it.
#
targetdef fetch {
    * = STRING;
}

#
# Combine several registries into one, choosing the registry for each package by
# its name:
#
#     repository_group @deps {
#         @acme/* = @internal;
#         *       = @npm;
#     }
#
# Dependencies are then written `@deps:<package>:<version>`, and versions are
# chosen across all the registries together. A key is a package name, a name
# prefix ending in `*`, or `*` alone for everything else. The longest matching
# key decides, whatever order the entries are written in. A package is looked up
# only in the registry its name selects, never in another as a fallback. The
# registries must all be of the same kind.
#
# A value can instead be a target or files, to be used as the package of exactly
# that name.
#
targetdef repository_group {
    * = FILES;
}

#
# The packages installed with fabr itself: its plugins and the tools they use.
# The standard library declares `fabr_home @fabr-build { }`, so that a name such
# as `@fabr-build/sass-pnp-importer` refers to the installed package, at the
# version that is installed, unless the project declares a target of that name.
#
targetdef fabr_home {
}

fabr_home @fabr-build { }

#
# A named switch. A target turns a flag on by listing it in its `deps`, and the
# rules that build the target decide what it means (`dom`, `ts/no_strict`).
# Declare your own to give a set of flags one name:
#
#     flag legacy_ts { provides = ts/no_strict_null_checks ts/allow_implicit_any; }
#
targetdef flag {
    # Other flags this one turns on, or files it supplies.
    provides = FILES;
}
