#
# Definitions for the container plugin.
#

#
# The platform images are looked up at and built for: a target triple whose OS
# is `linux`. Only its CPU chooses among an image's platforms.
#
default OCI_TARGET = ${TARGET/-*/-unknown-linux};

#
# A registry speaking the OCI distribution API. A name in it is an image's name
# and a tag or digest, so `@docker:node:22-bookworm-slim:etc/os-release` is that
# file of the image the tag names for `OCI_TARGET`.
#
targetdef oci_repository {
    # The registry's URL, as in `https://ghcr.io`.
    url = REQUIRED STRING;
    # The namespace an image named by one segment is in (`library` on Docker Hub).
    default_namespace = STRING;
    # The address a login to the registry is filed under, as given to
    # `docker login` or `podman login`: by default the host of `url`.
    login_url = STRING;
}

#
# An OCI image: `base`'s layers, and one layer above them holding `files`, with
# its settings applied to the base's config. `fabr ls`, `cat` and `cp` read the
# image's filesystem.
#
targetdef container_image {
    # The image to build on: a reference (`@docker:debian:12-slim`) or another
    # `container_image`. None: an image of only this target's layer.
    base = PACKAGES;
    # Files placed in the image under their own names, from `/`. They are
    # resolved for the image's platform and the base's C library.
    files = FILES;
    # The program the container runs: a path or command inside the image.
    # Replaces the base's entrypoint and command.
    entry = STRING;
    # Arguments placed after `entry`, ahead of any given when the image is run.
    args = STRING;
    # The directory the container's process starts in.
    workdir = STRING;
    # The user the container's process runs as (`name`, `uid`, `uid:gid`).
    user = STRING;
    # Environment variables, set over the base's.
    env = MAP;
    # Ports the image exposes: `8080`, or with its protocol, `53/udp`.
    ports = STRING;
    # Facts about the image, written as its labels over the base's: OCI's keys
    # (`description`, `licenses`, `source`, `url`, `title`, `documentation`,
    # `vendor`, `authors`) as `org.opencontainers.image.<key>`, any other as written.
    metadata = MAP;
}

rule container_image c<BUILD_OPERATION=build> = @fabr-build/container:rules/BuildContainerImage;

####################### Repository ##########################

#
# Docker Hub.
#

default oci_repository @docker {
  url = https://registry-1.docker.io;
  default_namespace = library;
  login_url = https://index.docker.io/v1/;
}

#
# How the OCI repository type is made.
#
repository oci_repository = @fabr-build/container:OciRepository;
