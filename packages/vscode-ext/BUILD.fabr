# The VS Code extension, and the wrapper it runs the editor's TypeScript server
# through. Nothing of fabr runs in it: a project's own fabr describes the
# project, and supplies the plugin implementation the wrapper's shim loads.
# Built by fabr alone: extension.json is the extension's manifest, which the
# package's generated package.json is made from.
js_package vscode-ext {
  srcs = src:**/*.ts extension.json -> package.json README.md icon.png ../../COPYING -> LICENSE
         language-configuration.json syntaxes/*.json
         fabr-jdtls-importer:*.jar -> jdtls/*.jar;
  # The extension's entry point, and the modules the tsdk directory loads.
  exports = src:index.ts src:tsserver/Wrapper.ts src:tsserver/Shim.ts;
  tests = src:**/*.test.ts;
  # js-tools: the type of the units a project document carries, which its plugin defines.
  compile_deps = @pkg:@types/node @fabr-build/js-tools @pkg:@types/vscode;
  # typescript: the wrapper's tests run a real tsserver behind it.
  test_deps = chai jest_types @pkg:typescript;
  # An extension is installed as it is built, so it carries fabr's version itself.
  version = ${FABR_VERSION};
  # The extension's own engine beside fabr's.
  metadata = {
    FABR_METADATA;
    description = "Fabr projects in VS Code: the editor's TypeScript server shown each compilation unit as fabr compiles it";
    engines = { node = ">=22.19.0"; vscode = "^1.90.0"; }
  }
}

# The extension as VS Code installs it: `code --install-extension vscode-ext.vsix`.
generate vscode_ext_vsix {
  srcs = vscode-ext<BUILD_TYPE=release> vsix.vscodeignore -> .vscodeignore;
  run = @npm:@vscode/vsce:4.1.0 package --no-dependencies -o vscode-ext.vsix;
  output = vscode-ext.vsix;
}

# The Java language server's own packages, which a bundle it loads is compiled
# against: its own from Eclipse's repository, what they require from Maven Central.
maven_repository @jdtls-releases {
  url = "https://repo.eclipse.org/content/repositories/jdtls-releases";
}

repository_group @jdtls {
  org.eclipse.jdt.ls/* = @jdtls-releases;
  * = @mvn;
}

# The bundle the Java extension loads into the Java language server (the
# extension's `javaExtensions`): it imports each Java package the project's
# build server describes as a project of the language server's own.
jar_package fabr-jdtls-importer {
  srcs = jdtls/src:**/*.java;
  resources = jdtls:plugin.xml;
  deps = java21;
  # The language server's own bundles, which it runs the importer with.
  compile_deps = @jdtls:org.eclipse.jdt.ls:org.eclipse.jdt.ls.core:1.63.0.20261019125307
                 @jdtls:org.eclipse.platform:org.eclipse.core.resources:3.24.100
                 @jdtls:org.eclipse.platform:org.eclipse.core.runtime:3.35.0
                 @jdtls:org.eclipse.jdt:org.eclipse.jdt.core:3.47.0
                 @jdtls:org.eclipse.jdt:org.eclipse.jdt.launching:3.24.300
                 @jdtls:org.eclipse.lsp4j:org.eclipse.lsp4j:1.0.0
                 @jdtls:com.google.code.gson:gson:2.15.0;
  manifest = {
    Bundle-ManifestVersion = 2;
    Bundle-Name = "Fabr project importer";
    Bundle-SymbolicName = "build.fabr.jdtls.importer;singleton:=true";
    Bundle-Version = ${FABR_VERSION};
    Bundle-RequiredExecutionEnvironment = JavaSE-21;
    Bundle-ActivationPolicy = lazy;
    Require-Bundle = "org.eclipse.jdt.ls.core,org.eclipse.core.runtime,org.eclipse.core.resources,org.eclipse.jdt.core,org.eclipse.jdt.launching,org.eclipse.equinox.common,org.eclipse.core.jobs,org.eclipse.lsp4j,org.eclipse.lsp4j.jsonrpc,com.google.gson";
  }
}
