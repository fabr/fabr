# The Java plugin. Fabr does not need it to build itself, so only fabr builds it.

# The plugin's code.
js_package @fabr-build/java-boot {
  srcs = src:**/*.ts ../../README.md -> README.md ../../COPYING -> LICENSE;
  # The entry point, and the modules JAVA.fabr's rule and repository declarations name.
  exports = src:rules/!(*.test).ts src:MavenRepository.ts src:JdkDistribution.ts;
  tests = src:**/*.test.ts;
  deps = @pkg:@types/node @pkg:sax;
  compile_deps = @pkg:@types/sax;
  provided_deps = @fabr-build/core;
  test_deps = chai jest_types;
  metadata = { FABR_METADATA; description = Fabr Java support plugin }
}

# The plugin, built in the project: its code and JAVA.fabr.
fabr_plugin @fabr-build/java {
  srcs = @fabr-build/java-boot;
  libs = lib/JAVA.fabr;
}
