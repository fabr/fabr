# The Java plugin. Fabr does not need it to build itself, so only fabr builds it.

# The plugin's code.
js_package @fabr-build/java-boot {
  srcs = src:**/*.ts ../../README.md -> README.md ../../COPYING -> LICENSE;
  # The entry point, and the modules JAVA.fabr's rule and repository declarations name.
  exports = src:rules/!(*.test).ts src:MavenRepository.ts src:JdkDistribution.ts;
  tests = src:**/*.test.ts;
  deps = @pkg:@types/node @pkg:sax;
  compile_deps = @pkg:@types/sax;
  provided_deps = @fabr-build/core;
  test_deps = chai jest_types;
  metadata = { FABR_METADATA; description = Fabr Java support plugin }
}

# The plugin, built in the project: its code, JAVA.fabr and the test runner.
# The runner is built with the plugin's own rules, so the plugin is used at a
# stage that carries no runner (`STAGE=0`), and the plugin built at the next
# stage, the one published, does.
fabr_plugin @fabr-build/java {
  srcs = @fabr-build/java-boot;
  libs = lib/JAVA.fabr;
  resources<STAGE=1> = fabr-junit-runner;
}

# Which stage of a plugin built with its own rules is built: 0, without what
# those rules build; 1, with it.
STAGE = 1;

plugin @fabr-build/java<STAGE=0>;

# The runner `jar_package` tests run with by default: it runs test classes on
# the JUnit Platform and reports in CTRF. It runs on Java 11 and later.
jar_package fabr-junit-runner {
  srcs = runner:*.java;
  deps = java11;
  compile_deps = @mvn:org.junit.platform:junit-platform-launcher:1.11.4;
}
