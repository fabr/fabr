##################### Global Properties ####################

#
# The Maven repository that `@mvn` refers to. Set it to use a mirror for
# every package.
#

default MAVEN_REPOSITORY_URL = https://repo1.maven.org/maven2;

#
# The Java release compiled classes run on, written `jvm<release>`: `jvm17`,
# `jvm21`. Sources declared with a `java<release>` flag compile for that
# release instead, which must not be later.
#

default JVM_TARGET = jvm21;

#
# The JDK release the Java tools come from: `@jdk:21.0.12.1+1`, or any release
# `fabr ls @jdk` lists.
#

default JDK = @jdk:21.0.12.1+1;

#
# The Java compiler: a `javac`, by default the `JDK` release's.
#

default JAVAC = JDK:javac;

#
# The Java runtime programs run on: a `java`, by default the `JDK` release's.
#

default JAVA = JDK:java;

#
# The Java documentation generator: a `javadoc`, by default the `JDK`
# release's.
#

default JAVADOC = JDK:javadoc;

#
# The jar that runs a `jar_package`'s tests on the JUnit Platform and reports
# what happened: fabr's own, by default. It runs with the JUnit Platform
# launcher the tests' own `test_deps` name.
#

default JAVA_TEST_RUNNER = @fabr-build/java:fabr-junit-runner.jar;

#################### Source version flags ##################

# The sources are written for Java 8: using a later language feature or API
# is a compile error, whatever release `JVM_TARGET` names.
default flag java8 { }
# The sources are written for Java 11. See `java8`.
default flag java11 { }
# The sources are written for Java 17. See `java8`.
default flag java17 { }
# The sources are written for Java 21. See `java8`.
default flag java21 { }
# The sources are written for Java 25. See `java8`.
default flag java25 { }

####################### Target types #######################

#
# Build a jar from Java sources and resources:
#
#     jar_package com.example/app {
#       srcs = src/main/java:**/*.java;
#       resources = src/main/resources:**;
#       deps = @mvn:org.slf4j:slf4j-api:1.7.36;
#       main_class = com.example.Main;
#       tests = src/test/java:**/*.java;
#       test_deps = @mvn:org.junit:junit-bom:5.11.4
#                   @mvn:org.junit.jupiter:junit-jupiter
#                   @mvn:org.junit.platform:junit-platform-launcher;
#     }
#
# `fabr run` runs its `main_class` with the jar and everything it requires on
# the classpath, and `fabr test` runs the tests its `tests` compile to on the
# JUnit Platform, with the test engines and the platform's launcher in its
# `test_deps`. `fabr doc` generates its javadoc, and `fabr sources` gives its
# sources.
#

targetdef jar_package {
    # The Java sources.
    srcs = FILES;
    # The packages the sources use, and `java<release>` flags. A BOM here
    # (`@mvn:org.springframework.boot:spring-boot-dependencies:2.7.18`) gives
    # the versions of the packages it manages where they are used, so those
    # may be written without one (`@mvn:org.springframework.boot:spring-boot-starter-web`).
    deps = PACKAGES;
    # Packages the sources use that whatever runs the jar must provide, such as
    # the servlet API a container supplies. The jar does not carry them.
    provided_deps = PACKAGES;
    # As `provided_deps`, for packages whatever runs the jar may leave out: the
    # jar uses them where they are present.
    optional_provided_deps = PACKAGES;
    # Packages the sources are compiled against that nothing needs when the jar
    # runs, such as an annotations-only jar. They are not passed on.
    compile_deps = PACKAGES;
    # The annotation processors the compiler runs, such as lombok: packages,
    # resolved apart from the ones the sources use.
    processors = PACKAGES;
    # Files to put in the jar as they are, named as they are found on the
    # classpath (`application.properties`). A jar or zip among them is stored
    # uncompressed, so that a nested jar can be read in place.
    resources = FILES;
    # The class the program starts in (`com.example.Main`), which the jar's
    # manifest names as its `Main-Class`: one of the jar's, or of a package it
    # requires.
    main_class = STRING;
    # Java agents `fabr run` runs the jar with: each package's jar is given the
    # JVM as a `-javaagent`, and what it requires joins the classpath.
    agents = PACKAGES;
    # Further attributes of the jar's manifest (`Implementation-Version`,
    # `Automatic-Module-Name`), each a string.
    manifest = MAP;
    # The test sources, compiled against the jar. The test engines on the
    # classpath find the tests among the classes they compile to.
    tests = FILES;
    # Packages only the tests use: JUnit's API, its test engines and the JUnit
    # Platform launcher they run on, of one JUnit release.
    test_deps = PACKAGES;
    # Files on the classpath the tests run with, as `resources` are.
    test_resources = FILES;
}

#
# A Java program, made to run: its sources compiled and the packages it
# requires, started in its main class. `fabr run` runs it, and a `generate`
# command may use it as a tool:
#
#     java_program spotbugs {
#       deps = @mvn:com.github.spotbugs:spotbugs:4.8.6;
#       args = -textui;
#     }
#

targetdef java_program {
    # The program's own Java sources, compiled against `deps`.
    srcs = FILES;
    # The packages the program runs with, and `java<release>` flags.
    deps = PACKAGES;
    # The annotation processors the compiler runs on `srcs`: packages,
    # resolved apart from `deps`.
    processors = PACKAGES;
    # The class the program starts in (`com.example.Main`). Where it is not
    # given, the class of the sole source, or with no sources, the `Main-Class`
    # of the sole package's jar.
    main_class = STRING;
    # Arguments given the program, before any its caller gives.
    args = STRING;
    # Arguments given the JVM, before the program: `-Xmx2g`, `"-Dname=value"`.
    jvm_args = STRING;
    # Java agents the program runs with: each package's jar is given the JVM
    # as a `-javaagent`, and what it requires joins the classpath.
    agents = PACKAGES;
}

#
# A web application archive: the classes its sources compile to and its
# `resources` under `WEB-INF/classes`, the installation of its `deps` under
# `WEB-INF/lib`, and its `webapp` files at the root, packed as `<name>.war`:
#
#     war_package shop {
#       srcs = src/main/java:**/*.java;
#       webapp = src/main/webapp:**;
#       deps = @mvn:org.apache.commons:commons-text:1.11.0;
#       provided_deps = @mvn:jakarta.servlet:jakarta.servlet-api:6.0.0;
#     }
#

targetdef war_package {
    # The Java sources.
    srcs = FILES;
    # The packages the sources use, and `java<release>` flags.
    deps = PACKAGES;
    # Packages the sources use that the container supplies, such as the
    # servlet API. The archive does not carry them.
    provided_deps = PACKAGES;
    # The annotation processors the compiler runs: packages, resolved apart
    # from the ones the sources use.
    processors = PACKAGES;
    # Files on the application's classpath, under `WEB-INF/classes`.
    resources = FILES;
    # The web content, at the archive's root: pages, `WEB-INF/web.xml`.
    webapp = FILES;
}

rule war_package w<BUILD_OPERATION=build> = war:*.jar -> *.war {
    java_compile classes {
        srcs = w.srcs;
        deps = w.deps w.provided_deps;
        processors = w.processors;
    }
    java_installation libs {
        deps = w.deps;
    }
    jar_package war {
        resources = classes:classes/** -> WEB-INF/classes/** w.resources:** -> WEB-INF/classes/**
                    libs:** -> WEB-INF/lib/** w.webapp;
    }
}

#
# An enterprise application archive: its `modules` (the wars and jars it
# deploys) and `resources` at the root, and the installation of its `deps`
# under `lib`, packed as `<name>.ear`:
#
#     ear_package store {
#       modules = shop;
#       deps = @mvn:org.apache.commons:commons-lang3:3.14.0;
#     }
#

targetdef ear_package {
    # The modules the application deploys: `war_package` and `jar_package`
    # archives.
    modules = FILES;
    # The packages the modules share, under `lib`.
    deps = PACKAGES;
    # Files at the archive's root, such as `META-INF/application.xml`.
    resources = FILES;
}

rule ear_package e<BUILD_OPERATION=build> = ear:*.jar -> *.ear {
    java_installation libs {
        deps = e.deps;
    }
    jar_package ear {
        resources = e.modules libs:** -> lib/** e.resources;
    }
}

#
# A jar_package's javadoc: of its `srcs`, and of the sources its annotation
# processors generate.
#

rule jar_package pkg<BUILD_OPERATION=doc> = docs<BUILD_OPERATION=build> {
    java_compile compile {
        srcs = pkg.srcs;
        deps = pkg.deps pkg.provided_deps pkg.optional_provided_deps pkg.compile_deps;
        processors = pkg.processors;
    }
    javadoc docs {
        srcs = pkg.srcs compile:generated/** -> **;
        deps = pkg.deps pkg.provided_deps pkg.optional_provided_deps pkg.compile_deps;
    }
}

#
# A jar_package's sources, as a sources jar holds them: its `srcs`, the
# sources its annotation processors generate, and its `resources`, with what
# they name built under `build`.
#

rule jar_package pkg<BUILD_OPERATION=sources> = contents<BUILD_OPERATION=build> {
    java_compile compile {
        srcs = pkg.srcs;
        deps = pkg.deps pkg.provided_deps pkg.optional_provided_deps pkg.compile_deps;
        processors = pkg.processors;
    }
    contents = pkg.srcs compile:generated/** -> ** pkg.resources;
}

#
# The target types below are normally created for you by the ones above, and
# rarely need declaring.
#

#
# Compile Java sources to classes: the classes under `classes/`, and the
# sources its annotation processors generate under `generated/`. A
# `jar_package` does this for its own sources.
#

targetdef java_compile {
    # The Java sources.
    srcs = FILES;
    # The packages the sources use, and `java<release>` flags.
    deps = PACKAGES;
    # The annotation processors the compiler runs: packages, resolved apart
    # from `deps`.
    processors = PACKAGES;
}

#
# Generate the javadoc of Java sources: HTML documentation of their API. A
# `jar_package` does this for its own sources under `doc`.
#

targetdef javadoc {
    # The Java sources.
    srcs = FILES;
    # The packages the sources use, and `java<release>` flags.
    deps = PACKAGES;
}

#
# The installation of packages: the jars of every package `deps` hold or
# reach, each by its own file name, with the loose files among `deps` as they
# are.
#

targetdef java_installation {
    # The packages installed, and loose files.
    deps = PACKAGES;
}

#
# A Maven repository, laid out as Maven Central is.
#

targetdef maven_repository {
    # The URL the repository is published under.
    url = REQUIRED STRING;
}

#
# Eclipse Temurin JDK releases, from the Adoptium API: `@jdk:21.0.12.1+1` is
# that release for the target platform, and `@jdk:21.0.12.1+1:javac` its
# compiler. A release is named as Adoptium names it, less its `jdk-` prefix
# (`@jdk:8u302-b08` for Java 8); `fabr ls @jdk` lists them. fabr declares
# `@jdk` for you; declaring it yourself points it at a mirror of the API:
#
#     jdk_distribution @jdk { url = "https://adoptium.example.com"; }
#

targetdef jdk_distribution {
    # The URL the Adoptium API is served under.
    url = REQUIRED STRING;
}

####################### Repository ##########################

#
# Maven Central, or the repository `MAVEN_REPOSITORY_URL` names.
#

default maven_repository @mvn {
    url = ${MAVEN_REPOSITORY_URL};
}

#
# JDK releases, from the Adoptium API.
#

default jdk_distribution @jdk {
    url = "https://api.adoptium.net";
}

#
# How the Java target types are built, and the Maven and JDK repository types made.
#
rule jar_package pkg<BUILD_OPERATION=build> = @fabr-build/java:rules/BuildJarPackage;
rule jar_package pkg<BUILD_OPERATION=run> = @fabr-build/java:rules/RunJarPackage;
rule jar_package pkg<BUILD_OPERATION=test> = @fabr-build/java:rules/TestJarPackage;
rule java_compile c<BUILD_OPERATION=build> = @fabr-build/java:rules/BuildJavaCompile;
rule javadoc d<BUILD_OPERATION=build> = @fabr-build/java:rules/BuildJavadoc;
rule java_installation i<BUILD_OPERATION=build> = @fabr-build/java:rules/BuildJavaInstallation;
rule java_program p<BUILD_OPERATION=run> = @fabr-build/java:rules/RunJavaProgram;

repository maven_repository = @fabr-build/java:MavenRepository;
repository jdk_distribution = @fabr-build/java:JdkDistribution;
