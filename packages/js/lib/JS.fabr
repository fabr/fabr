##################### Global Properties ####################

#
# Primary URL for the remote NPM repository. You'll usually want to override this if you're using
# a private mirror/cache.
#

default NPM_REPOSITORY_URL = https://registry.npmjs.org/;

#
# The default target for JS output.
# This is constructed as a pair of <ES-version>-<Module-Format>
#

default JS_TARGET = es6-esm;

#
# The default typescript compiler to use (if compiling typescript).
# You'll usually want to override this to set a specific version.
# (Note these must be pinned versions or ranges; mutable dist-tags like
# 'latest' are not supported as they make the build non-deterministic.)
#

default TSC = @npm:typescript:5.4.5;

#
# The default esbuild bundler used for JS bundling. 
#

default ESBUILD = @npm:esbuild:0.28.1;

#
# The CSS toolchain the css_compile driver uses: the Sass compiler and the
# lightningcss library (css-modules scoping + prefixing/minify). Pinned like any
# tool; lightningcss is native and rides the same os/cpu platform-gating as
# esbuild, so its per-platform binary resolves automatically.
#

default SASS = @npm:sass-embedded:1.100.0;
default LIGHTNINGCSS = @npm:lightningcss:1.30.2;

# The test runner ('fabr test' / js_test) is fabr's own: it is sourced directly
# from the installed @fabr/js providing the js rules, not resolved as a build
# target. Selecting an alternative runner is deferred to a future version.

################### JS-specific targets ####################

#
# Standard Javascript / NPM package.
#

targetdef js_package {
    srcs = FILES;
    deps = FILES;
    tests = FILES;
    # Extra packages for compiling and running the tests only (assertion
    # libraries and their @types); never part of the package's own
    # dependencies. The describe/it globals are provided (and typed) by the
    # test runner.
    test_deps = FILES;
    version = STRING;
}

#
# Bundle a JavaScript/TypeScript source tree into a self-contained artifact. 
# 'srcs' is the extra sources allowed INTO the bundle (plain files land at the
# working root; packages mount under node_modules and are inlined); 'entry' is
# the source(s) to bundle (a glob gives N independent bundles) — entry files are
# included automatically, so they need not also be listed in 'srcs'; 'deps'
# is what the RUNTIME provides — externalized by package identity, so their
# imports survive verbatim (the lambda case: handler + vendored libs in srcs,
# @aws-sdk/* in deps). 'output' optionally renames each entry's default output
# (identity modulo .ts/.tsx -> .js), e.g. `*.entry.js -> *.min.js`. Minify and
# sourcemaps follow BUILD_TYPE; platform/format follow JS_TARGET.
#

targetdef js_bundle {
    srcs = FILES;
    entry = REQUIRED FILES;
    deps = FILES;
    output = REWRITE;
}

#
# Lower a styled source tree to plain CSS. 'srcs' are the styled sources
# (.scss/.sass, css-modules .module.{scss,css}, plain .css); 'deps' are scss
# packages mounted for Sass '@use'/'@import' resolution (the Sass loadPaths
# analogue of node_modules). Each plain source becomes a .css; each .module.*
# becomes a scoped .css plus a proxy .js (the class-name value map + a
# side-effect import of the scoped CSS). Composed automatically by js_bundle for
# any styled sources; also declarable directly. Uses SASS + LIGHTNINGCSS.
#

targetdef css_compile {
    srcs = FILES;
    deps = FILES;
}

#
# Standalone Javascript test target: 'tests' are the test files, compiled and
# run under fabr's own test runner; 'deps' are everything they need but that
# isn't itself a test — packages, and plain-source support (e.g. a test harness,
# which compiles as a sibling so `./harness` resolves, but is never run).
#

targetdef js_test {
    tests = FILES;
    deps = FILES;
}

#
# Define a runnable Javascript program (run it with 'fabr run', collect its
# output with the generic 'run' target, or check it with a golden test). 'deps'
# assemble the install — packages mount under node_modules, loose filesets land
# at their own paths; 'entry' is the path WITHIN that install to launch under
# node (so a package script runs from its node_modules mount and its relative
# imports resolve, e.g. entry = node_modules/@babel/core/bin/babel.js); 'args'
# are fixed leading arguments. It yields a runnable, it does not itself execute.
#

targetdef js_script {
    deps = FILES;
    entry = REQUIRED STRING;
    args = STRING;
}

#
# npmjs.org compatible repository, specified by URL.
#

targetdef npm_repository {
    url = REQUIRED STRING;
}


####################### Repository ##########################

#
# Convenience provider for the public npmjs.org repository.
#

npm_repository @npm {
    url = ${NPM_REPOSITORY_URL};
}
