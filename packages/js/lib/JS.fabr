##################### Global Properties ####################

#
# The registry that `@npm` refers to. Set it to use a mirror or a private
# registry for every package.
#

default NPM_REPOSITORY_URL = https://registry.npmjs.org/;

#
# The JavaScript to emit, written `<ES version>-<module format>-<environment>`:
# `es2022`, `es2022-esm`, `es2020-esm-browser`. The module format is `commonjs`
# (assumed when left out), `esm`, or `dual`, which builds a `js_package` in both
# formats. The environment is `node` (assumed when left out) or `browser`.
#

default JS_TARGET = es6-esm;

#
# Internal: the program that runs the TypeScript compiler. To choose the
# compiler version, set `TYPESCRIPT`.
#

default TSC_DRIVER = @fabr-build/js-tools/tsc-driver;

#
# The TypeScript compiler that compiles your sources, as a version or a range.
# A dist-tag such as `latest` is not accepted.
#

default TYPESCRIPT = @npm:typescript:5.6.3;

#
# The esbuild that `js_bundle` bundles with.
#

default ESBUILD = @npm:esbuild:0.28.1;

#
# The Sass compiler that compiles `.scss` and `.sass` sources.
#

default SASS = @npm:sass-embedded:1.100.0;

#
# Internal: how Sass finds stylesheets inside packages. Installed with fabr.
#

default SASS_PNP_IMPORTER = @fabr-build/sass-pnp-importer;

#
# The PostCSS that processes css-modules.
#

default POSTCSS = @npm:postcss:8.5.28;

#
# The PostCSS plugin that scopes the class names of css-modules.
#

default POSTCSS_MODULES = @npm:postcss-modules:9.0.1;

#
# Internal: the program `js_bundle` runs, which drives esbuild.
#

default JS_BUNDLER = @fabr-build/js-tools/bundle-driver;

#
# Internal: the program `sass_compile` runs, which drives Sass.
#

default SASS_DRIVER = @fabr-build/js-tools/sass-driver;

#
# Internal: the program `css_postcss` runs, which drives PostCSS.
#

default POSTCSS_DRIVER = @fabr-build/js-tools/postcss-driver;

#
# The test framework a project's tests are written for: `node` (Node.js's
# built-in `node:test`), `jest` or `vitest`. A target overrides it with its
# `test_framework` property (`framework` on a `js_test`).
#

default JS_TEST_FRAMEWORK = node;

#
# The program that runs tests under the `node` framework. A replacement is run
# in the directory of compiled tests as `<runner> --report=<file>
# --env=<node|jsdom> [--update-snapshots] [--setup=<file>]… <test files…>`. It
# must exit with a non-zero status when a test fails, and write its results to
# the report file in CTRF form.
#

default JS_NODE_TEST_RUNNER = @fabr-build/js-tools/test-runner;

#
# The program that runs tests under the `jest` framework, invoked as
# `JS_NODE_TEST_RUNNER` is.
#

default JS_JEST_RUNNER = @fabr-build/js-tools/jest-runner;

#
# The program that runs tests under the `vitest` framework, invoked as
# `JS_NODE_TEST_RUNNER` is.
#

default JS_VITEST_RUNNER = @fabr-build/js-tools/vitest-runner;

#
# The jest release that the `jest` test framework uses. Jest 29 and 30 are
# supported.
#

default JEST = @npm:jest:30.3.0;

#
# Internal: the compiler the `jest` test framework uses to move `jest.mock`
# calls above a file's imports.
#

default SWC = @npm:@swc/core:1.15.43;

#
# Versions for the `@types` packages that jest's own dependencies require
# without a minimum version. Change it together with `JEST` if another jest
# release needs different ones.
#

default JEST_TYPE_PINS = @npm:@types/node:20.12.7
                         @npm:@types/babel__generator:7.27.0
                         @npm:@types/babel__template:7.4.4
                         @npm:@types/babel__traverse:7.28.0
                         @npm:@types/istanbul-lib-report:3.0.3
                         @npm:@types/yargs-parser:21.0.3;

################### Source-mode flags #####################

#
# Flags that change how TypeScript reads one target's sources. The compile is
# strict by default; a target lists these in its `deps` to relax it.
#
# Each is named for the tsconfig option it sets, in snake_case: `no_` turns an
# option off, a bare name turns one on, and an option whose own name is negative
# reads `allow_` (`noImplicitAny: false` is `ts/allow_implicit_any`).
#
# The strictness flags affect checking only. `ts/no_es_module_interop` and the
# decorator flags also change the emitted JavaScript.
#

# Turn off all of TypeScript's `strict` checks for this target's sources.
flag ts/no_strict { }
# Allow implicit `any` (`noImplicitAny: false`).
flag ts/allow_implicit_any { }
# Allow `this` to be implicitly `any` (`noImplicitThis: false`).
flag ts/allow_implicit_this { }
# Treat `null` and `undefined` as members of every type
# (`strictNullChecks: false`), as TypeScript did before 2.0.
flag ts/no_strict_null_checks { }
# Allow class properties that aren't definitely assigned
# (`strictPropertyInitialization: false`).
flag ts/no_strict_property_initialization { }
# Compare function parameter types bivariantly (`strictFunctionTypes: false`),
# as TypeScript did before 2.6.
flag ts/no_strict_function_types { }
# Leave the argument types of `bind`, `call` and `apply` unchecked
# (`strictBindCallApply: false`), as TypeScript did before 3.2.
flag ts/no_strict_bind_call_apply { }
# Type a caught error as `any` rather than `unknown`
# (`useUnknownInCatchVariables: false`), as TypeScript did before 4.4.
flag ts/no_use_unknown_in_catch_variables { }
# Compile without `esModuleInterop`, for sources that import a callable
# CommonJS module with `import * as x` rather than a default import.
flag ts/no_es_module_interop { }
# Leave side-effect imports unchecked (`noUncheckedSideEffectImports: false`),
# so that `import "./typo.css"` naming no file is not an error. Needs
# TypeScript 5.6 or later; an earlier compiler rejects the option.
flag ts/allow_unchecked_side_effect_imports { }
# Compile decorators with the semantics TypeScript used before 5.0
# (`experimentalDecorators: true`). Class fields are then assigned rather than
# defined, because a defined field would hide the accessor a property decorator
# installs.
flag ts/experimental_decorators { }
# Also emit type metadata for decorators (`emitDecoratorMetadata: true`), as
# dependency-injection containers built on `reflect-metadata` need. Imports used
# only as types in decorated signatures are kept at run time. Turns on
# `ts/experimental_decorators` too.
flag ts/emit_decorator_metadata { provides = ts/experimental_decorators; }

################## Source version flags ###################

#
# The ECMAScript version a target's SOURCES are written against, as opposed to
# `JS_TARGET`'s version, which is what gets emitted. A target lists one in its
# `deps`; with none, the source version follows `JS_TARGET`.
#
# Sources declared below es2022 keep assignment semantics for class fields even
# when emitted for a later target, because `useDefineForClassFields` turns on at
# ES2022 and changes what a class field does.
#

# The sources are written against ES5: using a newer API is a compile error,
# whatever version `JS_TARGET` emits.
flag es5 { }
# The same as `es2015`.
flag es6 { }
# The sources are written against ES2015: using a newer API is a compile error,
# whatever version `JS_TARGET` emits. A package built from them needs a runtime
# that supports ES2015, so the flag also applies to targets that depend on it.
flag es2015 { }
# The sources are written against ES2016. See `es2015`.
flag es2016 { }
# The sources are written against ES2017. See `es2015`.
flag es2017 { }
# The sources are written against ES2018. See `es2015`.
flag es2018 { }
# The sources are written against ES2019. See `es2015`.
flag es2019 { }
# The sources are written against ES2020. See `es2015`.
flag es2020 { }
# The sources are written against ES2021. See `es2015`.
flag es2021 { }
# The sources are written against ES2022. See `es2015`.
flag es2022 { }
# The sources are written against ES2023. See `es2015`.
flag es2023 { }
# The sources may use the newest APIs the compiler knows. See `es2015`.
flag esnext { }

#
# The sources use browser APIs. Adds the DOM type declarations to the compile,
# and runs the target's tests in a jsdom environment.
#
flag dom { }

#
# The sources use the globals Node.js gives every module: `process`, `Buffer`
# and `global`. In a `js_bundle` for a browser, the flag binds `process` and
# `Buffer` to the `process` and `buffer` packages, which the bundle must list in
# its `srcs`, and `global` to `globalThis`. In a bundle for Node.js it does
# nothing.
#
flag js/node_globals { }

################### JS-specific targets ####################

#
# An npm package compiled from TypeScript or JavaScript sources, with a
# generated `package.json`:
#
#     js_package mylib {
#       srcs = src:**/*.ts;
#       deps = @npm:lodash:4.17.21;
#       tests = src:**/*.test.ts;
#     }
#
# `fabr build` produces the package, `fabr test` runs its tests, and `fabr run`
# runs its command-line program, which is any script directly under `bin/`.
#

targetdef js_package {
    # The sources to compile: TypeScript, JavaScript and stylesheets. A
    # `package.json` here supplies fields for the generated one.
    srcs = FILES;
    # The packages the sources import, written to `dependencies`. Also takes
    # flags, and source files to compile with the package without shipping.
    deps = FILES;
    # Packages the sources import but whoever uses this package supplies, such
    # as `react` for a component library. Written to `peerDependencies`.
    provided_deps = FILES;
    # The package's public entry points, named by the sources they compile
    # from. They are compiled even if `srcs` doesn't list them.
    exports = FILES;
    # Files to ship in the package as they are, without compiling or checking
    # them.
    resources = FILES;
    # The test files. Every source file here is run as a test, so helpers and
    # the `setupTests` file go in `test_deps`, and snapshots in
    # `test_expectations`.
    tests = FILES;
    # Packages only the tests import, such as an assertion library and its
    # types. A source file here is compiled with the tests but not run as a
    # test, and not shipped.
    test_deps = FILES;
    # Snapshot files the tests compare against (`__snapshots__/*.snap`).
    # `fabr test -u` updates them.
    test_expectations = FILES;
    # Files the tests read when they run. Neither compiled nor shipped.
    test_resources = FILES;
    # Environment variables for the test processes, which run with no others.
    test_env = MAP;
    # The test framework the tests are written for: `node`, `jest` or `vitest`.
    test_framework = STRING default ${JS_TEST_FRAMEWORK};
    # The package's version.
    version = STRING;
    # Other `package.json` fields, such as `description`, `license` and
    # `repository`. A value is a string, a block for an object
    # (`repository = { type = git; url = …; };`), or several blocks for an
    # array. Fields fabr generates (`name`, `version`, `main`, `exports`,
    # `dependencies` and the like) and fields a published package doesn't carry
    # (`devDependencies`, `scripts`, `private`, …) are rejected.
    metadata = MAP;
}

#
# Bundle sources and their dependencies into self-contained JavaScript files,
# with esbuild:
#
#     js_bundle handler {
#       entry = src:handler.ts;
#       srcs = src:**/*.ts @npm:lodash:4.17.21;
#     }
#
# The module format and platform follow `JS_TARGET`. `release` and
# `relwithdebinfo` builds are minified; `debug` and `relwithdebinfo` builds have
# source maps.
#

targetdef js_bundle {
    # What may go into the bundle: source files, and packages to include in it.
    srcs = FILES;
    # The file to bundle. A pattern matching several files produces one bundle
    # for each. Entry files need not also be in `srcs`.
    entry = REQUIRED FILES;
    # Packages the environment the bundle runs in already has. Imports of them
    # are left in the output and their code is not included.
    deps = FILES;
    # Renames the output files, which are otherwise named after each entry with
    # a `.js` extension: `*.js -> *.min.js`.
    output = REWRITE;
    # Constants to substitute at compile time (esbuild's `define`). Each value
    # is JavaScript source text, so a string needs its own quotes:
    # `process.env.NODE_ENV = '"production"';`, but `DEBUG = false;`.
    defines = MAP;
}

#
# Tests that don't belong to a package, such as an end-to-end suite:
#
#     js_test e2e {
#       tests = test:**/*.test.ts;
#       deps = test:**/*.ts mylib @npm:@types/node:22.15.3;
#     }
#
# A source file named `setupTests` at the root of the source tree is loaded in
# every test process before the test file.
#

targetdef js_test {
    # The test files. Every source file here is run as a test, so helpers and
    # the `setupTests` file go in `deps`, and snapshots in `expectations`.
    tests = FILES;
    # Packages the tests import, and source files to compile with them that
    # aren't themselves tests.
    deps = FILES;
    # The test framework the tests are written for: `node`, `jest` or `vitest`.
    framework = STRING default ${JS_TEST_FRAMEWORK};
    # Files the tests read when they run.
    resources = FILES;
    # Environment variables for the test processes, which run with no others.
    env = MAP;
    # Snapshot files the tests compare against (`__snapshots__/*.snap`).
    # `fabr test -u` updates them.
    expectations = FILES;
}

#
# A Node.js program that can be run: with `fabr run`, as a command in a
# `generate` target, or as the `tool` of a `serve` target.
#
#     js_script migrate { entry = scripts/migrate.ts; deps = @npm:pg:8.11.5; }
#
#     js_script docs_tool { entry = @npm:astro:7.1.1; deps = @npm:@astrojs/starlight:0.41.3; }
#
# The second form adds dependencies to a packaged tool, such as plugins it loads
# by name. `entry` and `deps` are installed together, with one version of each
# package.
#

targetdef js_script {
    # The packages the program imports, and other files it needs.
    deps = FILES;
    # The script file to run, or a package to run by its command-line program.
    # Where a package has several, name one: `@npm:typescript:5.6.3:tsc`.
    entry = REQUIRED FILES;
    # Arguments passed to the program ahead of any given when it is run.
    args = STRING;
}

#
# An npm registry, to fetch packages from and publish them to:
#
#     npm_repository @internal { url = https://npm.example.com/; access = private; }
#
# Packages in it are then written `@internal:<package>:<version>`. Credentials
# come from `.npmrc`.
#

targetdef npm_repository {
    # The registry's URL.
    url = REQUIRED STRING;
    # The access requested when a package is first published: `public`, or
    # `private` (`restricted` means the same).
    access = STRING;
}

#
# The target types below are normally created for you by the ones above, and
# rarely need declaring.
#

#
# Compile TypeScript and JavaScript sources to JavaScript and type declarations.
# A `js_package`, `js_test` or `js_script` does this for its own sources; declare
# one to compile sources on their own.
#

targetdef js_compile {
    # The sources: `.ts`, `.tsx`, `.js`, `.jsx`, and `.d.ts` declarations.
    srcs = FILES;
    # The packages the sources import.
    deps = FILES;
    # The package name the sources can import themselves by.
    package_name = STRING;
    # Set to `.mjs` to name the emitted JavaScript `.mjs` rather than `.js`,
    # with the imports between the files written to match.
    module_extension = STRING;
    # Rules that rename import specifiers (`*.scss -> *.css`), applied when
    # resolving an import and to the import written in the output.
    rewrite_imports = REWRITE;
    # Files that aren't compiled but that the sources import, such as
    # stylesheets, so that those imports resolve.
    resources = FILES;
}

#
# Compile Sass sources to CSS. A `js_package` or `js_bundle` does this for the
# Sass among its own sources; declare one to compile Sass on its own.
#
# Each `.scss` or `.sass` source produces a `.css` file of the same name
# (`x.module.scss` produces `x.module.css`), with a source map in builds that
# have them. Partials (`_x.scss`) produce nothing.
#

targetdef sass_compile {
    # The Sass sources.
    srcs = FILES;
    # Packages whose stylesheets the sources load with `@use` or `@import`.
    deps = FILES;
}

#
# Scope the css-modules in a set of CSS files. A `js_package` or `js_bundle`
# does this for its own stylesheets; declare one to process CSS on its own.
#
# Each `x.module.css` produces `x.css` with its class names scoped, and a
# TypeScript module `x.css.ts` exporting them. Other stylesheets are copied
# unchanged.
#

targetdef css_postcss {
    # The stylesheets: `.css` files, or the output of a `sass_compile`.
    srcs = FILES;
    # Packages whose stylesheets a `composes` can name
    # (`composes: x from 'pkg/base.css'`).
    deps = FILES;
    # The package name that scoped class names are derived from, together with
    # each file's path.
    package_name = STRING;
}


####################### Repository ##########################

#
# The public npm registry, or the registry `NPM_REPOSITORY_URL` names.
# Packages published to it are public; to publish private packages, declare an
# `npm_repository` with `access = private;`.
#

default npm_repository @npm {
    url = ${NPM_REPOSITORY_URL};
    access = public;
}

##################### Driver tools ########################

#
# The programs fabr runs to drive each tool, declared as ordinary runnable
# targets over the compiled scripts shipped in this installation (paths are
# relative to this file). Each is reached through a global (`JS_BUNDLER`,
# `SASS_DRIVER`, …). They are named under `@fabr-build/js-tools` rather than
# `@fabr-build/js`, because that name is a target in a project that builds the
# plugin itself, and a name cannot be both a target and a namespace.
#

# Internal: runs esbuild for `js_bundle`. The default `JS_BUNDLER`.
js_script @fabr-build/js-tools/bundle-driver {
    entry = ../bundleDriver/bundle-driver.js;
    deps = ${ESBUILD} ../pnp/PnPResolver.js ../pnp/PnPApi.js ../pnp/VirtualPath.js ../pnp/PackageExports.js ../pnp/ReadSet.js;
}

# Internal: runs Sass for `sass_compile`. The default `SASS_DRIVER`.
js_script @fabr-build/js-tools/sass-driver {
    entry = ../cssDriver/sass-driver.js;
    deps = ${SASS} ${SASS_PNP_IMPORTER}
           ../cssDriver/Support.js
           ../pnp/PnPResolver.js ../pnp/PnPApi.js ../pnp/VirtualPath.js ../pnp/PackageExports.js ../pnp/ReadSet.js;
}

# Internal: runs PostCSS for `css_postcss`. The default `POSTCSS_DRIVER`.
js_script @fabr-build/js-tools/postcss-driver {
    entry = ../cssDriver/postcss-driver.js;
    deps = ${POSTCSS} ${POSTCSS_MODULES} ../cssDriver/Support.js;
}

# Internal: runs the TypeScript compiler for `js_compile`, through its API.
# The default `TSC_DRIVER`.
js_script @fabr-build/js-tools/tsc-driver {
    entry = ../tscDriver/tsc-driver.js;
    deps = ../pnp/PnPResolver.js ../pnp/PnPApi.js ../pnp/VirtualPath.js ../pnp/PackageExports.js ../pnp/ReadSet.js
           ../tscDriver/Planning.js ../tscDriver/Wave.js ${TYPESCRIPT};
}

# Runs tests under the `node` framework, with Node.js's `node:test`. The
# default `JS_NODE_TEST_RUNNER`.
js_script @fabr-build/js-tools/test-runner {
    entry = ../testRunner/runner.js;
    deps = ../testRunner/Assets.js ../testRunner/Report.js ../testRunner/globals.js ../testRunner/RunTests.js
           ../testRunner/test-globals.d.ts;
}

# Runs tests under the `jest` framework, with jest's own test framework and
# libraries and Node.js's module loader. The default `JS_JEST_RUNNER`.
js_script @fabr-build/js-tools/jest-runner {
    entry = ../jestRunner/runner.js;
    deps = ${JEST} ${SWC} JEST_TYPE_PINS
           ../jestRunner/child.js ../jestRunner/Config.js ../jestRunner/Environment.js
           ../jestRunner/Failures.js ../jestRunner/Hoist.js ../jestRunner/JestObject.js ../jestRunner/Registry.js
           ../jestRunner/RuntimeFacade.js ../jestRunner/SnapshotResolver.js ../jestRunner/Tools.js
           ../testRunner/Assets.js ../testRunner/Report.js ../testRunner/RunTests.js;
}

# Runs tests under the `vitest` framework, with the vitest the target declares
# in its `test_deps`. The default `JS_VITEST_RUNNER`.
js_script @fabr-build/js-tools/vitest-runner {
    entry = ../vitestRunner/runner.js;
    deps = ../vitestRunner/preload.js ../vitestRunner/VitestRun.js
           ../testRunner/Assets.js ../testRunner/Report.js ../testRunner/RunTests.js
           vitest-runner.package.json -> package.json;
}
