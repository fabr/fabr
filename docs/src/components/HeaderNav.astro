// The header's top-level nav, as an override of Starlight's `SocialIcons` — the
// slot that sits at the right of the header bar, and again in the mobile menu
// footer. The section links go ahead of the stock social icons, which render
// after them from `social:` config.
import Default from "@astrojs/starlight/components/SocialIcons.astro";

// Each section points at its first page: only /introduction/ and /quickstart-js/
// are pages in their own right. An entry without `match` is external (never the
// current page).
const SECTIONS = [
  { label: "Introduction", href: "/introduction/", match: "/introduction/" },
  { label: "News", href: "https://blog.fabr.build/" },
  { label: "Quickstart", href: "/quickstart-js/", match: "/quickstart-js/" },
  { label: "Guides", href: "/guides/concepts/", match: "/guides/" },
  { label: "Reference", href: "/reference/command-line/", match: "/reference/" },
];

const path = Astro.url.pathname;
---

<nav class="fabr-nav" aria-label="Sections">
  {
    SECTIONS.map((s) => (
      <a href={s.href} aria-current={s.match && path.startsWith(s.match) ? "page" : undefined}>
        {s.label}
      </a>
    ))
  }
</nav>
<Default {...Astro.props}><slot /></Default>

<style>
  .fabr-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--sl-font-mono), monospace;
    font-size: var(--sl-text-sm);
  }
  .fabr-nav a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .fabr-nav a:hover,
  .fabr-nav a[aria-current='page'] {
    color: var(--sl-color-white);
  }
  /* Tighten up where the links share the bar with the search box. Below 50rem
     Starlight hides the whole right-hand group and the mobile menu takes over —
     its footer (`.mobile-preferences`) is outside `.header`, so it keeps these. */
  @media (max-width: 64rem) {
    :global(.header) .fabr-nav {
      gap: 1rem;
      font-size: var(--sl-text-xs);
    }
    /* Everywhere but the landing page the theme control shares the bar too, and
       that no longer fits — those pages have the sidebar to navigate by. */
    :global(body:not(:has(.fabr-home)) .header) .fabr-nav {
      display: none;
    }
  }
  :global(.mobile-preferences) .fabr-nav {
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
