# Documentation site: an Astro + Starlight project under docs/
js_script astro {
  entry = @npm:astro:7.1.1;
  deps = @npm:@astrojs/starlight:0.41.3;
}

js_script gendoc {
  entry = ../scripts/gendoc.ts;
  deps = @pkg:@types/node;
}

# The target reference is generated from the live build model: `list-all` emits
# the whole vocabulary (types, config, flags), the plugins' optional libs among
# it, and gendoc writes a page per source package and per plugin's optional libs,
# each at its place in the site under content/, with reference-pages.json, the
# sidebar entry of each, which astro.config.mjs reads.
# fabr with the Java and AWS plugins installed beside it, so the generated
# reference covers every plugin.
js_script docgen_fabr {
  entry = @fabr-build/cli;
  deps = @fabr-build/java @fabr-build/aws;
}

generate reference_docs {
  srcs = ./DOCGEN.fabr -> PROJECT.fabr;
  run = docgen_fabr list-all --include-optional --json | gendoc out;
  output = out:**;
}

# The changelog and the version shown on the landing page are read from their
# real homes at the repo root rather than copied into the site: the release notes
# page renders ../CHANGELOG.md, and Home.astro imports the CLI's package version.
generate docs_site {
  srcs = ./src/** ./public/** ./astro.config.mjs
         ../CHANGELOG.md -> src/changelog.md
         release/@npm/@fabr-build/cli/*/package.json -> src/fabr-version.json
         reference_docs:content/** -> src/content/docs/**
         reference_docs:reference-pages.json;
  run = astro build;
  output = dist:**;
}

serve docs_serve {
  tool = @npm:http-server:14.1.1;
  files = docs_site;
  # -c-1 disables http-server's cache-control (max-age -1), so edits show on reload.
  args = -c-1 .;
}
