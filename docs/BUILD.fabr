# Documentation site: an Astro + Starlight project under docs/
js_script astro {
  entry = @npm:astro:7.1.1;
  deps = @npm:@astrojs/starlight:0.41.3;
}

js_script gendoc {
  entry = ../scripts/gendoc.ts;
  deps = @pkg:@types/node;
}

# The target reference is generated from the live build model: `list-all` emits
# the whole vocabulary (types, config, flags) and gendoc writes one page per
# source package (core -> standard-rules.md, JS plugin -> js-targets.md, Java
# plugin -> java-targets.md). gendoc
# writes them by bare name; docs_site places each in the content tree with a
# rename projection.
# fabr with the Java plugin installed beside it, so the generated reference
# covers both plugins.
js_script docgen_fabr {
  entry = @fabr-build/cli;
  deps = @fabr-build/java;
}

generate reference_docs {
  srcs = ./DOCGEN.fabr -> PROJECT.fabr;
  run = docgen_fabr list-all --json | gendoc;
  output = *.md;
}

# The changelog and the version shown on the landing page are read from their
# real homes at the repo root rather than copied into the site: the release notes
# page renders ../CHANGELOG.md, and Home.astro imports the CLI's package version.
generate docs_site {
  srcs = ./src/** ./public/** ./astro.config.mjs
         ../CHANGELOG.md -> src/changelog.md
         release/@npm/@fabr-build/cli/*/package.json -> src/fabr-version.json
         reference_docs:standard-rules.md -> src/content/docs/reference/standard-rules.md
         reference_docs:js-targets.md -> src/content/docs/reference/js/targets.md
         reference_docs:java-targets.md -> src/content/docs/reference/java/targets.md;
  run = astro build;
  output = dist:**;
}

serve docs_serve {
  tool = @npm:http-server:14.1.1;
  files = docs_site;
  # -c-1 disables http-server's cache-control (max-age -1), so edits show on reload.
  args = -c-1 .;
}
